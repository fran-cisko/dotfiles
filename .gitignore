# Secretos y credenciales
*.secret
*.key
*.pem
*.env
.env.*
secrets/
*.token

# Archivos locales / específicos de máquina
# `*.local` ignora archivos, pero no directorios como `scripts/.local/`.
*.local
!*.local/
*.local.*
*.bak
*.orig

# Cachés y temporales
*.log
*.tmp
*.swp
*~
.DS_Store
.cache/
__pycache__/
*.pyc

# Estado de apps (no versionar)
*.db
*.sqlite
*.sqlite3
