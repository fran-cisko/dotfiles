#!/usr/bin/env python3
"""Abre Obsidian, espera a que se cierre y sincroniza la bóveda con rclone."""

import argparse
import os
import shutil
import subprocess
import sys
from pathlib import Path


def notify(title: str, message: str, icon: str = "obsidian") -> None:
    if not shutil.which("notify-send"):
        print(f"[{title}] {message}")
        return
    try:
        subprocess.run(
            ["notify-send", title, message, "-i", icon, "-a", "Obsidian Auto-Sync"],
            check=False,
        )
    except Exception as exc:
        print(f"No se pudo enviar la notificación: {exc}", file=sys.stderr)


def find_obsidian(explicit: str | None) -> str:
    if explicit:
        return explicit

    env = os.environ.get("OBSIDIAN_BIN")
    if env:
        return env

    found = shutil.which("obsidian")
    if found:
        return found

    for candidate in (
        Path.home() / "AppImages" / "obsidian.appimage",
        Path.home() / "Applications" / "Obsidian.AppImage",
    ):
        if candidate.is_file():
            return str(candidate)

    return ""


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Abre Obsidian y, al cerrarlo, sincroniza la bóveda con rclone.",
        formatter_class=argparse.RawTextHelpFormatter,
    )
    parser.add_argument("--obsidian", default=None, help="Ruta al ejecutable/AppImage de Obsidian.")
    parser.add_argument(
        "--vault",
        default=os.environ.get("OBSIDIAN_VAULT", str(Path.home() / "Documents" / "My_Obsidian_Vault")),
        help="Carpeta local de la bóveda.",
    )
    parser.add_argument(
        "--remote",
        default=os.environ.get("OBSIDIAN_RCLONE_REMOTE", "gdrive1:My_Obsidian_Vault"),
        help="Destino de rclone (remote:ruta).",
    )
    parser.add_argument("--no-notify", action="store_true", help="No envía notificaciones.")
    args = parser.parse_args()

    obsidian = find_obsidian(args.obsidian)
    if not obsidian:
        print("❌ No encontré Obsidian. Indícalo con --obsidian o define OBSIDIAN_BIN.", file=sys.stderr)
        return 1
    if not Path(obsidian).is_file():
        print(f"❌ No existe el ejecutable: {obsidian}", file=sys.stderr)
        return 1

    vault = Path(args.vault).expanduser()
    if not vault.is_dir():
        print(f"❌ No existe la bóveda: {vault}", file=sys.stderr)
        return 1

    if not shutil.which("rclone"):
        print("❌ rclone no está instalado o no está en PATH.", file=sys.stderr)
        return 1

    print(f"Iniciando Obsidian ({obsidian})...")
    subprocess.run([obsidian])

    if not args.no_notify:
        notify(
            "Obsidian Backup",
            "Sincronizando notas con Google Drive...",
            icon="network-transmit-receive",
        )

    print(f"Sincronizando {vault} → {args.remote}")
    result = subprocess.run(
        ["rclone", "sync", str(vault), args.remote, "-P", "--checkers", "16"]
    )

    if result.returncode == 0:
        print("Sincronización completada.")
        if not args.no_notify:
            notify("Obsidian Backup", "Sincronización completada con éxito.", icon="emblem-default")
    else:
        print(f"Error en la sincronización. Código: {result.returncode}", file=sys.stderr)
        if not args.no_notify:
            notify(
                "Obsidian Backup",
                f"Error en la sincronización. Código: {result.returncode}",
                icon="dialog-error",
            )

    return result.returncode


if __name__ == "__main__":
    sys.exit(main())
